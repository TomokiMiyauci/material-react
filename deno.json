{
  "name": "@miyauci/material-react",
  "exports": {
    ".": "./src/mod.ts"
  },
  "imports": {
    "@std/fs": "jsr:@std/fs@^1.0.19",
    "@std/path": "jsr:@std/path@^1.1.2",
    "@std/testing": "jsr:@std/testing@^1.0.16",
    "@types/react": "npm:@types/react@^19.1.11",
    "autoprefixer": "npm:autoprefixer@^10.4.21",
    "cssnano": "npm:cssnano@^7.1.1",
    "postcss": "npm:postcss@^8.5.6",
    "postcss-import": "npm:postcss-import@^16.1.1",
    "react": "npm:react@^19.1.1",
    "@internal/": "./src/components/_internal/",
    "style-dictionary": "npm:style-dictionary@^5.0.2",
    "@/": "./src/",
    "~/": "./",
    "react-dsd": "./src/components/_internal/dsd/mod.ts",
    "@testing": "./tests/mod.ts"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "noUnusedLocals": true,
    "noImplicitReturns": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true
  },
  "tasks": {
    "generate:example": "deno run --allow-write=src/styles --allow-sys --allow-env --allow-read scripts/gen_example.ts",
    "build": "deno run -P=build scripts/build.ts",
    "test": "deno test -P=test"
  },
  "nodeModulesDir": "auto",
  "permissions": {
    "build": {
      "env": true,
      "sys": true,
      "read": true,
      "write": ["./src"],
      "net": true,
      "run": true
    },
    "test": {
      "read": true,
      "env": true
    }
  }
}
