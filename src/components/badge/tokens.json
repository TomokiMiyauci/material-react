{
  "container": {
    "color": {
      "$type": "string",
      "$value": "md.sys.color.error",
      "$description": "Badge color",
      "$extensions": {
        "type": "token"
      }
    },
    "shape": {
      "$type": "string",
      "$value": "md.sys.shape.corner.full",
      "$description": "Badge shape",
      "$extensions": {
        "type": "token"
      }
    },
    "size": {
      "$type": "number",
      "$value": 6,
      "$description": "Badge size",
      "$extensions": {
        "unit": "dp"
      }
    },
    "large": {
      "color": {
        "$type": "string",
        "$value": "md.sys.color.error",
        "$description": "Badge large color",
        "$extensions": {
          "type": "token"
        }
      },
      "shape": {
        "$type": "string",
        "$value": "md.sys.shape.corner.full",
        "$description": "Badge large shape",
        "$extensions": {
          "type": "token"
        }
      },
      "size": {
        "$type": "number",
        "$value": 16,
        "$description": "Badge size",
        "$extensions": {
          "unit": "dp"
        }
      }
    }
  },
  "label text": {
    "large": {
      "color": {
        "$type": "string",
        "$value": "md.sys.color.on-error",
        "$description": "Badge large label text color",
        "$extensions": {
          "type": "token"
        }
      },
      "font": {
        "$type": "string",
        "$value": "md.sys.typescale.label-small.font",
        "$description": "Badge large label text font",
        "$extensions": {
          "type": "token"
        }
      },
      "line height": {
        "$type": "string",
        "$value": "md.sys.typescale.label-small.line-height",
        "$description": "Badge large label text line height",
        "$extensions": {
          "type": "token"
        }
      },
      "size": {
        "$type": "string",
        "$value": "md.sys.typescale.label-small.size",
        "$description": "Badge large label text size",
        "$extensions": {
          "type": "token"
        }
      },
      "tracking": {
        "$type": "string",
        "$value": "md.sys.typescale.label-small.tracking",
        "$description": "Badge large label text tracking",
        "$extensions": {
          "type": "token"
        }
      },
      "weight": {
        "$type": "string",
        "$value": "md.sys.typescale.label-small.weight",
        "$description": "Badge large label text weight",
        "$extensions": {
          "type": "token"
        }
      }
    }
  }
}
