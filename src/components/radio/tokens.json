{
  "icon": {
    "selected": {
      "color": {
        "$type": "string",
        "$value": "md.sys.color.primary",
        "$description": "Radio button icon selected color",
        "$extensions": { "type": "token" }
      }
    },
    "unselected": {
      "color": {
        "$type": "string",
        "$value": "md.sys.color.on-surface-variant",
        "$description": "Radio button icon unselected color",
        "$extensions": { "type": "token" }
      }
    },
    "size": {
      "$type": "number",
      "$value": 20,
      "$description": "Radio button icon size",
      "$extensions": { "unit": "dp" }
    },

    "disabled": {
      "selected": {
        "color": {
          "$type": "string",
          "$value": "md.sys.color.on-surface",
          "$description": "Radio button disabled selected icon color",
          "$extensions": { "type": "token" }
        },
        "opacity": {
          "$type": "number",
          "$value": 0.38,
          "$description": "Radio button disabled selected icon opacity",
          "$extensions": { "ratio": true }
        }
      },
      "unselected": {
        "color": {
          "$type": "string",
          "$value": "md.sys.color.on-surface",
          "$description": "Radio button disabled unselected icon color",
          "$extensions": { "type": "token" }
        },
        "opacity": {
          "$type": "number",
          "$value": 0.38,
          "$description": "Radio button disabled unselected icon opacity",
          "$extensions": { "ratio": true }
        }
      }
    },

    "hovered": {
      "selected": {
        "icon": {
          "color": {
            "$type": "string",
            "$value": "md.sys.color.primary",
            "$description": "Radio button selected hover icon color",
            "$extensions": { "type": "token" }
          }
        }
      },
      "unselected": {
        "icon": {
          "color": {
            "$type": "string",
            "$value": "md.sys.color.on-surface",
            "$description": "Radio button unselected hover icon color",
            "$extensions": { "type": "token" }
          }
        }
      }
    },

    "focused": {
      "selected": {
        "icon": {
          "color": {
            "$type": "string",
            "$value": "md.sys.color.primary",
            "$description": "Radio button selected focus icon color",
            "$extensions": { "type": "token" }
          }
        }
      },
      "unselected": {
        "icon": {
          "color": {
            "$type": "string",
            "$value": "md.sys.color.on-surface",
            "$description": "Radio button unselected focus icon color",
            "$extensions": { "type": "token" }
          }
        }
      }
    }
  },
  "state layer": {
    "size": {
      "$type": "number",
      "$value": 40,
      "$description": "Radio button state layer size",
      "$extensions": { "unit": "dp" }
    },
    "hovered": {
      "selected": {
        "color": {
          "$type": "string",
          "$value": "md.sys.color.primary",
          "$description": "Radio button selected hover state layer color",
          "$extensions": { "type": "token" }
        },
        "opacity": {
          "$type": "string",
          "$value": "md.sys.state.hover.state-layer-opacity",
          "$description": "Radio button selected hover state layer opacity",
          "$extensions": { "type": "token" }
        }
      },
      "unselected": {
        "color": {
          "$type": "string",
          "$value": "md.sys.color.on-surface",
          "$description": "Radio button unselected hover state layer color",
          "$extensions": { "type": "token" }
        },
        "opacity": {
          "$type": "string",
          "$value": "md.sys.state.hover.state-layer-opacity",
          "$description": "Radio button unselected hover state layer opacity",
          "$extensions": { "type": "token" }
        }
      }
    },
    "focused": {
      "selected": {
        "color": {
          "$type": "string",
          "$value": "md.sys.color.primary",
          "$description": "Radio button selected focus state layer color",
          "$extensions": { "type": "token" }
        },
        "opacity": {
          "$type": "string",
          "$value": "md.sys.state.focus.state-layer-opacity",
          "$description": "Radio button selected focus state layer opacity",
          "$extensions": { "type": "token" }
        }
      },
      "unselected": {
        "color": {
          "$type": "string",
          "$value": "md.sys.color.on-surface",
          "$description": "Radio button unselected focus state layer color",
          "$extensions": { "type": "token" }
        },
        "opacity": {
          "$type": "string",
          "$value": "md.sys.state.focus.state-layer-opacity",
          "$description": "Radio button unselected focus state layer opacity",
          "$extensions": { "type": "token" }
        }
      }
    }
  }
}
