{
  "container color": {
    "$type": "string",
    "$value": "md.sys.color.surface-container",
    "$description": "Nav bar container color",
    "$extensions": {
      "type": "token"
    }
  },
  "container elevation": {
    "$type": "string",
    "$value": "md.sys.elevation.level2",
    "$description": "Nav bar container elevation",
    "$extensions": {
      "type": "token"
    }
  },
  "container shadow color": {
    "$type": "string",
    "$value": "md.sys.color.shadow",
    "$description": "Nav bar container shadow color",
    "$extensions": {
      "type": "token"
    }
  },
  "height": {
    "$type": "number",
    "$value": 64,
    "$description": "Nav bar height",
    "$extensions": {
      "unit": "dp"
    }
  },
  "shape": {
    "$type": "string",
    "$value": "md.sys.shape.corner.none",
    "$description": "Nav bar shape",
    "$extensions": {
      "type": "token"
    }
  },
  "space between items": {
    "$type": "number",
    "$value": 0,
    "$description": "Nav bar space between items"
  }
}