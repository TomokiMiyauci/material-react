{
  "steps": [
    {
      "use": "items2tokens",
      "input": "../_generated/items.json",
      "output": "./_generated/tokens.json",
      "options": {
        "include": {
          "matches": [
            "Nav bar container",
            "Nav bar space between items",
            "Nav bar height",
            "Nav bar shape"
          ]
        },
        "segments": ["Nav bar"],
        "path": {
          "exclude": {
            "matches": ["Nav bar"]
          }
        }
      }
    },
    {
      "use": "tokens2css",
      "input": "./_generated/tokens.json",
      "output": "./_generated/tokens.css"
    },
    {
      "use": "css",
      "input": "./style.css",
      "output": "./_generated/style.css",
      "options": {
        "minify": true,
        "embed": true
      }
    },
    {
      "use": "css2ts",
      "input": "./_generated/style.css",
      "output": "./_generated/style.ts"
    },
    {
      "use": "mustache",
      "input": "./README.md.mustache",
      "output": "./README.md",
      "options": {
        "tokenSource": "./_generated/style.css"
      }
    }
  ]
}
