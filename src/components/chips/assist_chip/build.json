{
  "steps": [
    {
      "use": "items2tokens",
      "input": "../_generated/items.json",
      "output": "./_generated/tokens.json",
      "options": {
        "include": {
          "matches": ["Assist chip"]
        },
        "exclude": {
          "matches": ["label text type"]
        },
        "segments": ["Assist chip", "label text", "state layer", "with icon"],
        "path": {
          "exclude": {
            "matches": ["Assist chip", "with icon"]
          },
          "heads": [
            "container",
            "icon",
            "label text",
            "state layer"
          ]
        }
      }
    },
    {
      "use": "tokens2css",
      "input": "./_generated/tokens.json",
      "output": "./_generated/tokens.css"
    },
    {
      "use": "css",
      "input": "./style.css",
      "output": "./_generated/style.css",
      "options": {
        "minify": true,
        "embed": true
      }
    },
    {
      "use": "css2ts",
      "input": "./_generated/style.css",
      "output": "./_generated/style.ts"
    },
    {
      "use": "mustache",
      "input": "./README.md.mustache",
      "output": "./README.md",
      "options": {
        "tokenSource": "./_generated/style.css"
      }
    }
  ]
}
