{
  "steps": [
    {
      "use": "items2tokens",
      "input": "../_generated/items.json",
      "output": "./_generated/tokens.json",
      "options": {
        "include": {
          "matches": ["Input chip"]
        },
        "exclude": {
          "matches": ["label text type"]
        },

        "segments": [
          "Input chip",
          "label text",
          "focus indicator",
          "state layer",
          "with leading icon",
          "with trailing icon",
          "with avatar",
          "leading icon",
          "trailing icon"
        ],

        "path": {
          "exclude": {
            "matches": [
              "Input chip",
              "with leading icon",
              "with trailing icon",
              "with avatar"
            ]
          },
          "heads": [
            "container",
            "label text",
            "focus indicator",
            "state layer",
            "leading icon",
            "trailing icon",
            "avatar",
            "selected",
            "unselected"
          ]
        }
      }
    },
    {
      "use": "tokens2css",
      "input": "./_generated/tokens.json",
      "output": "./_generated/tokens.css"
    },
    {
      "use": "css",
      "input": "./style.css",
      "output": "./_generated/style.css",
      "options": {
        "minify": true,
        "embed": true
      }
    },
    {
      "use": "css2ts",
      "input": "./_generated/style.css",
      "output": "./_generated/style.ts"
    }
  ]
}
