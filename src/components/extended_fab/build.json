{
  "steps": [
    {
      "use": "spec2tokens",
      "input": "https://m3.material.io/components/extended-fab/specs",
      "output": "./_generated/items.json",
      "run": { "skipIfExists": true }
    },
    {
      "use": "items2tokens",
      "input": "./_generated/items.json",
      "output": "./_generated/tokens.json",
      "options": {
        "segments": [
          "Extended FAB",
          "label text",
          "state layer",
          "container icon",
          "type style",
          "icon label"
        ],
        "path": {
          "exclude": {
            "matches": ["Extended FAB", "type style"]
          },
          "renames": {
            "container icon": "icon"
          },
          "heads": ["label text", "state layer", "icon", "container"]
        }
      }
    },
    {
      "use": "tokens2css",
      "input": "./_generated/tokens.json",
      "output": "./_generated/tokens.css"
    },
    {
      "use": "css",
      "input": "./style.css",
      "output": "./_generated/style.css"
    },
    {
      "use": "css2ts",
      "input": "./_generated/style.css",
      "output": "./_generated/style.ts"
    },
    {
      "use": "mustache",
      "input": "./README.md.mustache",
      "output": "./README.md",
      "options": {
        "tokenSource": "./_generated/style.css"
      }
    }
  ]
}
