    "color": {
      "$type": "string",
      "$value": "md.sys.color.surface-container",
      "$description": "Menu container color",
      "$extensions": { "type": "token" }
    },
    "elevation": {
      "$type": "string",
      "$value": "md.sys.elevation.level2",
